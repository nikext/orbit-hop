{
  "name": "orbit-hop",
  "private": true,
  "version": "1.0.0",
  "description": "One-thumb gravity-slingshot arcade game for YouTube Playables",
  "type": "module",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "bot": "tsx scripts/bot.ts",
    "check:bundle": "npm run build && node scripts/check-bundle.mjs",
    "shots": "node scripts/shots.mjs",
    "package": "npm run check:bundle && node scripts/package.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^7.3.7",
    "vitest": "^4.0.18"
  }
}
